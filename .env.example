# Opcional: chave da Steam Web API (https://steamcommunity.com/dev/apikey)
# Usada só para transformar /id/apelido em SteamID64.
NUXT_STEAM_API_KEY=

# Chave da SteamApis (steamapis.com > conta > API key). Lista de preços do mercado da Steam,
# lida uma vez por dia pelo job de preços. Os termos proíbem redistribuir os dados brutos.
NUXT_STEAMAPIS_KEY=

# Endereço público do site, sem barra no fim (ex.: https://dominio.com). Usado na imagem de
# compartilhamento e no link da prévia. Vazio: usa o endereço de cada requisição.
NUXT_PUBLIC_SITE_URL=

# Cabeçalho onde a hospedagem informa o IP do visitante (ex.: x-forwarded-for ou
# cf-connecting-ip). Usado no limite de consultas por IP. Vazio: usa o IP da conexão, o certo
# quando não há proxy na frente (como no computador do dono).
NUXT_IP_HEADER=

# Supabase (Project Settings > API Keys).
NUXT_SUPABASE_URL=
# Chave secreta (sb_secret_...): ignora o RLS. Só no servidor e nos jobs, nunca no navegador.
NUXT_SUPABASE_SECRET_KEY=
# Chave publishable (sb_publishable_...). Mesmo podendo ir para o navegador, fica só no servidor:
# login, cadastro e painel passam por ele. Com o token da sessão do revendedor, o RLS vale.
NUXT_SUPABASE_PUBLISHABLE_KEY=
# Conexão direta com o Postgres como dono do banco, só para aplicar as migrações de
# supabase/migrations. Fica só na máquina do dono: nunca no GitHub nem na hospedagem.
# Botão Connect > Session pooler, com a senha do banco no lugar de [YOUR-PASSWORD].
SUPABASE_DB_URL=
# Cloudflare Turnstile (cadastro e prévia). Ficam só na hospedagem: em desenvolvimento o
# nuxt.config.js usa as chaves de teste públicas da Cloudflare, que sempre passam.
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET_KEY=

# E-mails de conta: quem manda é o Supabase, pelo SMTP do Resend configurado no painel dele
# (Authentication > Emails > SMTP Settings). A chave do Resend não vai aqui nem na hospedagem.
# Modelos dos e-mails em supabase/emails/.

# Conexão do job de preços com o papel job_precos (só lê e grava preços). É esta que vai no
# secret do GitHub. Mesmo endereço do Session pooler, com usuário job_precos.<ref do projeto>.
PRECOS_DB_URL=

# E-mails de quem pode abrir o /admin (lojas, pagamentos e cobrança), separados por vírgula. A conta
# precisa existir no site com o e-mail confirmado. Conferido no servidor em toda página /admin e
# rota /api/admin. Vai também na hospedagem.
NUXT_ADMIN_EMAILS=
