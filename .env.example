# Opcional: chave da Steam Web API (https://steamcommunity.com/dev/apikey)
# Usada só para transformar /id/apelido em SteamID64.
NUXT_STEAM_API_KEY=

# Chave da SteamApis (steamapis.com > conta > API key). Lista de preços do mercado da Steam,
# lida uma vez por dia pelo job de preços. Os termos proíbem redistribuir os dados brutos.
NUXT_STEAMAPIS_KEY=

# Supabase (Project Settings > API Keys).
NUXT_SUPABASE_URL=
# Chave secreta (sb_secret_...): ignora o RLS. Só no servidor e nos jobs, nunca no navegador.
NUXT_SUPABASE_SECRET_KEY=
# Chave publishable (sb_publishable_...): pode ir para o navegador. Usada a partir da fase 4.
NUXT_PUBLIC_SUPABASE_KEY=
# Conexão direta com o Postgres como dono do banco, só para aplicar as migrações de
# supabase/migrations. Fica só na máquina do dono: nunca no GitHub nem na hospedagem.
# Botão Connect > Session pooler, com a senha do banco no lugar de [YOUR-PASSWORD].
SUPABASE_DB_URL=
# Conexão do job de preços com o papel job_precos (só lê e grava preços). É esta que vai no
# secret do GitHub. Mesmo endereço do Session pooler, com usuário job_precos.<ref do projeto>.
PRECOS_DB_URL=
